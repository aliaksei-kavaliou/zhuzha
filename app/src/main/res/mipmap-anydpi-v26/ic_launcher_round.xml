<?xml version="1.0" encoding="utf-8"?>
<!--
    The monochrome layer is what Android 13+ themed icons draw, tinted to the
    user's wallpaper colours. Her silhouette is already one colour with the
    notches as holes, so it costs nothing to supply and the icon stops
    falling back to an untinted square on exactly the Android version the
    Boox runs.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
