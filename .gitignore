# Secrets — never commit anything that could hold an API key.
# Runtime secrets live in Android Keystore/EncryptedSharedPreferences,
# not in files. But belt + suspenders:
*.env
*.env.*
secrets.properties
**/secrets.properties
*.pem
local.properties

# Gradle
.gradle/
.kotlin/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Android
*.apk
*.aab
*.ap_
*.dex
captures/
.externalNativeBuild/
.cxx/

# IDEs
.idea/
*.iml
.vscode/
.fleet/

# OS
.DS_Store
Thumbs.db

# Wrangler writes deploy state here when run from the repo root. It holds no
# credentials — those live in ~/Library/Preferences/.wrangler — but it does
# carry the Cloudflare account id and account name, and it is build state
# rather than source either way.
.wrangler/

# Working notes about how the work was done, rather than about the software.
# A contributor needs design.md and onyx-pen-thread.md; these are kept on
# disk and out of the repo.
docs/worklog.md
docs/naming-search.md
